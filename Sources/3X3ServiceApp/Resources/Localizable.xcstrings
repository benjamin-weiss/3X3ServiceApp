    },
    "Use this during installation when the partially visible second gear prevents the final gear from being inserted. Rotate it until the final gear fits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende diese Funktion bei der Montage, wenn der teilweise sichtbare zweite Gang das Einsetzen des letzten Gangs verhindert. Drehe ihn, bis der letzte Gang eingesetzt werden kann."
          }
        }
      }
    },
