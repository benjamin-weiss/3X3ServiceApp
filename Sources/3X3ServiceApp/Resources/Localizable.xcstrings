    "The Actuator did not confirm the Trigger pairing. Keep both devices close and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aktuator hat die Kopplung des Triggers nicht bestätigt. Halte beide Geräte nah beieinander und versuche es erneut."
          }
        }
      }
    },
    "The Actuator is shifting through every gear. Please wait for the process to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Aktuator schaltet durch alle Gänge. Bitte warte, bis der Vorgang abgeschlossen ist."
          }
        }
      }
    },
    "The Actuator pairing connection is no longer available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
